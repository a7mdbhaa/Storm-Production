{
  "name": "storm-translation",
  "version": "1.0.0",
  "private": true,
  "description": "Production multilingual Discord translation bot",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "wispbyte:start": "npm install && npx prisma generate && npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.0.0",
    "@prisma/client": "^6.0.0",
    "discord.js": "^14.19.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^0.26.0",
    "opusscript": "^0.0.8",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "prism-media": "^1.3.5",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
